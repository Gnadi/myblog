---
// Floating "Install app" button. Hidden by default; revealed only when the
// browser fires `beforeinstallprompt` AND the app is not already installed.
// Deliberately subtle so it doesn't dominate the page.
---

<button
  id="pwa-install"
  type="button"
  hidden
  aria-label="App installieren"
  class="fixed bottom-3 right-3 z-40 inline-flex items-center gap-1.5 rounded-full border border-gray-200 bg-white/80 px-3 py-1.5 text-xs font-medium text-gray-600 shadow-sm backdrop-blur transition hover:bg-white hover:text-gray-900 dark:border-gray-700 dark:bg-gray-800/80 dark:text-gray-300 dark:hover:bg-gray-800 dark:hover:text-white"
>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5" aria-hidden="true">
    <path d="M12 3v12" />
    <path d="m7 10 5 5 5-5" />
    <path d="M5 21h14" />
  </svg>
  Installieren
</button>

<script>
  const btn = document.getElementById("pwa-install") as HTMLButtonElement | null;
  if (btn) {
    let deferredPrompt: any = null;
    const KEY = "pwa-installed";

    function hide() {
      btn!.hidden = true;
    }

    // True when running inside the installed standalone app.
    function isStandalone() {
      return (
        window.matchMedia("(display-mode: standalone)").matches ||
        (navigator as any).standalone === true
      );
    }

    // Source of truth is getInstalledRelatedApps(); it also self-heals the
    // localStorage backstop so the button reappears after an uninstall.
    async function isInstalled() {
      if (isStandalone()) return true;
      const getApps = (navigator as any).getInstalledRelatedApps;
      if (typeof getApps === "function") {
        try {
          const apps = await getApps.call(navigator);
          const has = Array.isArray(apps) && apps.length > 0;
          if (has) localStorage.setItem(KEY, "1");
          else localStorage.removeItem(KEY);
          return has;
        } catch (e) {}
      }
      // Fallback for browsers without the API.
      return localStorage.getItem(KEY) === "1";
    }

    // Never offer install from within the installed app.
    if (isStandalone()) hide();

    window.addEventListener("beforeinstallprompt", async (e: Event) => {
      e.preventDefault();
      deferredPrompt = e;
      if (await isInstalled()) {
        hide();
        return;
      }
      btn.hidden = false;
    });

    btn.addEventListener("click", async () => {
      if (!deferredPrompt) return;
      deferredPrompt.prompt();
      await deferredPrompt.userChoice;
      deferredPrompt = null;
      hide();
    });

    // Hide as soon as the app is installed, and remember it.
    window.addEventListener("appinstalled", () => {
      localStorage.setItem(KEY, "1");
      deferredPrompt = null;
      hide();
    });

    // If the page transitions into standalone, hide immediately.
    window
      .matchMedia("(display-mode: standalone)")
      .addEventListener("change", (e) => {
        if (e.matches) hide();
      });
  }
</script>
