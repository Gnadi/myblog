---
import BaseLayout from "@/layouts/BaseLayout.astro";
import {useStoryblokApi} from "@storyblok/astro";
import Hero from "../../components/landing/Hero.astro";
import { contentVersion } from "../../utils/storyblok";
import { SITE_URL } from "../../consts";
import { breadcrumbNode, collectionPageNode } from "../../lib/schema";

const storyblokApi = useStoryblokApi();
const { data } = await storyblokApi.get('cdn/tags', {
  version: contentVersion,
})
const uniqueTags: string[] = [
  ...new Set<string>(data.tags.map((tag: { name: string }) => tag.name)),
];

const DESCRIPTION =
  "Alle Themen im Blog von Johannes Gnadlinger — von Familienalltag über Essen bis zu Technik.";
const canonical = `${SITE_URL}/tags/`;
const schema = [
  collectionPageNode(canonical, "Alle Themen", DESCRIPTION),
  breadcrumbNode(canonical, [
    { name: "HelloDad", item: `${SITE_URL}/` },
    { name: "Alle Themen" },
  ]),
];
---

<BaseLayout title="Alle Themen" description={DESCRIPTION} schema={schema}>
  <!-- Eigene Überschrift statt der Wortmarke: Sonst trügen Startseite und
       diese Seite dieselbe h1. -->
  <Hero heading="Alle Themen" />
  <section>
    <div class="px-8 md:px-12 mx-auto max-w-7xl py-12 lg:px-32">
      <ol role="list" class="flex flex-wrap gap-3">
        {
          uniqueTags.map((tag) => (
              <li class="inline-flex items-center uppercase mx-auto font-medium">
                <a href={`/tags/${encodeURIComponent(tag)}`} class="max-w-sm leading-tight">
                  <span class="link-underline text-black dark:text-white pb-2">{tag}</span>
                </a>
              </li>
          ))
        }
      </ol>
    </div>
  </section>
</BaseLayout>
