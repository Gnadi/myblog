---
import BaseLayout from "@/layouts/BaseLayout.astro";
import {useStoryblokApi} from "@storyblok/astro";
import BlogPostList from "../../storyblok/BlogPostList.astro";
import ThemeToggle from "../../components/ThemeToggle.astro";
import FontSizeControl from "../../components/FontSizeControl.astro";
import { getAllStories, contentVersion } from "../../utils/storyblok";
import { SITE_URL } from "../../consts";
import { breadcrumbNode, collectionPageNode } from "../../lib/schema";

export async function getStaticPaths() {
  const storyblokApi = useStoryblokApi();
  const { data } = await storyblokApi.get('cdn/tags', {
    version: contentVersion,
  })

  const uniqueTags: string[] = [
    ...new Set<string>(data.tags.map((tag: { name: string }) => tag.name)),
  ];
  return uniqueTags.map((tag) => {
    return {params: {tag: tag}}
  })
}

const { tag } = Astro.params;
const storyblokApi = useStoryblokApi();
const stories = await getAllStories(storyblokApi, {
  version: contentVersion,
  starts_with: "blog/",
  with_tag: tag,
});

const heading = `Blogposts „${tag}“`;
const description = `Alle Beiträge zum Thema „${tag}“ im Blog von Johannes Gnadlinger.`;
const canonical = `${SITE_URL}/tags/${encodeURIComponent(tag ?? "")}/`;
const schema = [
  collectionPageNode(canonical, heading, description),
  breadcrumbNode(canonical, [
    { name: "HelloDad", item: `${SITE_URL}/` },
    { name: "Alle Themen", item: `${SITE_URL}/tags/` },
    { name: tag ?? "" },
  ]),
];
---

<BaseLayout title={heading} description={description} schema={schema}>
  <div class="relative w-full">
    <div class="absolute right-5 top-5 lg:right-10 lg:top-10 flex items-center gap-3">
      <FontSizeControl />
      <ThemeToggle />
    </div>
  </div>
  <section>
    <div class="px-8 py-12 md:px-12 mx-auto lg:pb-24 max-w-7xl lg:px-32 lg:pt-48">
      <div class="lg:text-center">
        <!-- War ein <a href="/">, das nur wie eine Überschrift aussah: Die
             Seite hatte damit gar keine h1, und wer einen Screenreader nutzt,
             bekam den Seitentitel als Link zur Startseite vorgelesen. -->
        <h1 class="text-5xl tracking-tight text-balance font-medium font-display text-black dark:text-white md:text-6xl">
          {heading}
        </h1>
        <p class="mt-4 text-lg text-zinc-600 dark:text-zinc-400">
          <a href="/tags/" class="link-underline">Alle Themen</a>
        </p>
      </div>
      <BlogPostList blokdata={{ stories }}/>
    </div>
  </section>
</BaseLayout>
